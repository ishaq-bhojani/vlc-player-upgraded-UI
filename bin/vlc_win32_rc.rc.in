#define VERSION_NUMBER @VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_REVISION@,@VERSION_EXTRA@
#define VERSION_NUMBER_STR "@VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_REVISION@,@VERSION_EXTRA@"

#include <winuser.h>

VLC_ICON ICON "vireo.ico"

1 VERSIONINFO
FILETYPE 1
FILEOS 4
PRODUCTVERSION VERSION_NUMBER
FILEVERSION VERSION_NUMBER
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName", "Vireo contributors"
      VALUE "ProductName", "@REDESIGN_PRODUCT_NAME@"
      VALUE "ProductVersion", "@REDESIGN_RELEASE_VERSION@"
      VALUE "InternalName", "vireo"
      VALUE "OriginalFilename", "vireo.exe"
      VALUE "FileVersion", "@VERSION@"
      VALUE "FileDescription", "@REDESIGN_PRODUCT_NAME@, built on VLC media player"
      VALUE "LegalCopyright", "Copyright \251 @COPYRIGHT_YEARS@ VideoLAN and VLC Authors"
      VALUE "LegalTrademarks", "VLC media player, VideoLAN and x264 are registered trademarks from VideoLAN. @REDESIGN_PRODUCT_NAME@ is an independent project, not affiliated with VideoLAN"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "vireo.exe.manifest"
