<?xml version='1.0'?>
<Include>
    <?define ShortProductName = "Vireo" ?>
    <?define ProductName = "Vireo" ?>
    <?define Manufacturer = "Vireo contributors" ?>
    <?define AboutURL = "https://github.com/ishaq-bhojani/vlc-player-upgraded-UI" ?>
    <?define SupportURL = "https://github.com/ishaq-bhojani/vlc-player-upgraded-UI/issues" ?>
    <?define UpdatesURL = "https://github.com/ishaq-bhojani/vlc-player-upgraded-UI/releases" ?>

    <!-- Vireo: ProductVersion is the release version plus the build number (meson options
         redesign_release_version, redesign_build_number), e.g. 0.1.0.0, not VLC's engine version.
         MajorUpgrade compares only its first three fields (Windows Installer ignores the fourth), so
         the release version must grow from one published MSI to the next; a new build number alone
         is not an upgrade. -->
    <?define Version = "@REDESIGN_RELEASE_VERSION@" ?>
    <?define VersionLong = "$(var.Version).@REDESIGN_BUILD_NUMBER@" ?>

    <?define VlcInstallPrefix = "@PREFIX_PATH@" ?>

    <?if "@HAVE_NLS_TRUE@" = "" ?>
        <?define HaveLocale = "yes" ?>
    <?else ?>
        <?define HaveLocale = "no" ?>
    <?endif ?>
    <?if "@BUILD_SKINS_TRUE@" = "" ?>
        <?define HaveSkins = "yes" ?>
    <?else ?>
        <?define HaveSkins = "no" ?>
    <?endif ?>

    <?define SourceDir = "." ?>

    <?define Platform= "@WINDOWS_ARCH@" ?>

    <?if $(var.Platform) = "x86" ?>
        <?define Win64 = "no" ?>
        <?define PlatformString = "32-bit"?>
        <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
    <?else ?>
        <?define Win64 = "yes" ?>
        <?define PlatformString = "64-bit"?>
        <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
    <?endif ?>

    <?define AppFolder = "Vireo" ?>


    <?define BaseGuid = "ee2f4b33-b1d3-435b-9c54-8fb546afa8" ?>
    <?define CompInstallRegDir = "$(var.BaseGuid)10" ?>
    <?define CompVLCexe = "$(var.BaseGuid)11" ?>
</Include>
