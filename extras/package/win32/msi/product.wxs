<?include extras/package/win32/msi/config.wxi?>
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
    <Product
        Id='*'
        Name='$(var.ProductName)'
        Language='1033'
        Version='$(var.VersionLong)'
        Manufacturer='$(var.Manufacturer)'
        UpgradeCode='a653d119-25f5-4bf7-b9b0-7f55af541bf0'>
        <Package
            Description='$(var.ProductName) - built on VLC media player'
            Manufacturer='$(var.Manufacturer)'
            InstallPrivileges='elevated'
            InstallScope='perMachine'
            InstallerVersion='200'
            Compressed='yes'
            Platform="$(var.Platform)" />

        <Condition Message="This application is only supported on Windows 7 or higher.">
            <![CDATA[Installed OR (VersionNT >= 601)]]>
        </Condition>

        <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="A later version of [ProductName] is already installed. Setup will now exit."/>
        <Property Id="NSISLOCATION">
            <RegistrySearch Id="NSISLOCATION" Type="raw" Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Vireo" Name="UninstallString" />
        </Property>

        <Icon Id="vireo.ico" SourceFile="$(var.VlcInstallPrefix)vireo.ico"/>

        <!-- The about link that appears in Add & Remove Programs. -->
        <Property Id="ARPURLINFOABOUT" Value="$(var.AboutURL)" />
        <!-- The help link that appears in Add & Remove Programs. -->
        <Property Id="ARPHELPLINK" Value="$(var.SupportURL)" />
        <!-- The update link that appears in Add & Remove Programs. -->
        <Property Id="ARPURLUPDATEINFO" Value="$(var.UpdatesURL)" />
        <!-- The icon that appears in Add & Remove Programs. -->
        <Property Id="ARPPRODUCTICON" Value="vireo.ico" />


        <Property Id="ApplicationFolderName" Value="$(var.AppFolder)" />
        <Property Id="WixAppFolder" Value="WixPerMachineFolder" />
        <Property Id="APPLICATIONFOLDER">
            <RegistrySearch Id="FindInstallRegDir" Type="raw" Root="HKLM" Win64="$(var.Win64)" Key="Software\Vireo" Name="InstallDir" />
        </Property>

        <WixVariable Id="WixUISupportPerUser" Value="1" />
        <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)/LICENSE.rtf" />
        <WixVariable Id="WixUIBannerBmp" Value="$(sys.SOURCEFILEDIR)/vireo_bannrbmp.bmp" />

        <Media Id='1' Cabinet='product.cab' EmbedCab='yes' CompressionLevel="high" />

        <CustomAction Id="Overwrite_WixSetDefaultPerMachineFolder" Property="WixPerMachineFolder"
            Value="[$(var.PlatformProgramFilesFolder)][ApplicationFolderName]" Execute="immediate" />
        <InstallUISequence>
            <Custom Action="Overwrite_WixSetDefaultPerMachineFolder" After="WixSetDefaultPerMachineFolder" />
        </InstallUISequence>
        <InstallExecuteSequence>
            <Custom Action="Overwrite_WixSetDefaultPerMachineFolder" After="WixSetDefaultPerMachineFolder" />
        </InstallExecuteSequence>

        <SetProperty Id="ARPINSTALLLOCATION" Value="[APPLICATIONFOLDER]" After="CostFinalize" />

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                    <Directory Id='APPLICATIONFOLDER' Name='$(var.AppFolder)' FileSource="$(var.SourceDir)">

                        <Component Id="InstallRegDir" Guid="$(var.CompInstallRegDir)" DiskId="1" Win64="$(var.Win64)">
                            <RegistryKey Id='RegInstallDir' Root='HKLM' Key='Software\Vireo' Action='createAndRemoveOnUninstall' >
                                <RegistryValue Name='InstallDir' Type='string' Value='[APPLICATIONFOLDER]' />
                            </RegistryKey>
                        </Component>

                        <Component Id='CompVLC' Guid='$(var.CompVLCexe)' Win64="$(var.Win64)">
                            <File Id='vireo.exe' Name='vireo.exe' KeyPath='yes' Vital='yes' DiskId='1' Source="$(var.VlcInstallPrefix)vireo.exe"/>

                            <Shortcut Id="DesktopShortcut"
                                Directory="DesktopFolder"
                                Name="$(var.ProductName)"
                                WorkingDirectory="APPLICATIONFOLDER"
                                Description="$(var.ProductName)"
                                Icon='vireo.ico'
                                Advertise='yes' />

                            <!-- Capabilities keys for Vista/7 "Set Program Access and Defaults" -->
                            <RegistryValue Root="HKLM" Key="Software\Clients\Media\Vireo\Capabilities" Name="ApplicationDescription" Value="$(var.ProductName)" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Clients\Media\Vireo\Capabilities" Name="ApplicationIcon" Value="[#vireo.exe],0" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Clients\Media\Vireo\Capabilities" Name="ApplicationName" Value="$(var.ProductName)" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Clients\Media\Vireo\DefaultIcon" Value="[#vireo.exe],0" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Clients\Media\Vireo\shell\Open\command" Value="&quot;[#vireo.exe]&quot; --started-from-file &quot;%1&quot;" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="$(var.ShortProductName)" Value="Software\Clients\Media\Vireo\Capabilities" Type="string" />

                            <!-- Open With... contextual menu -->
                            <RegistryValue Root="HKCR" Key="Applications\vireo.exe\shell\open" Name="$(var.ShortProductName)" Value="$(var.ProductName)" Type="string" />

                            <!-- App Paths to support Start, Run -->
                            <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\vireo.exe" Value="[#vireo.exe]" Type="string" />
                            <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\vireo.exe" Name="Path" Value="[APPLICATIONFOLDER]" Type="string" />
                        </Component>

                        <Component Id='CompTXT' Guid='422d43f0-94f5-4265-989b-742d2da3a40a' Win64="$(var.Win64)">
                            <File Id='VLC_AUTHORS.txt' Name='VLC-AUTHORS.txt' DiskId='1'  Source="$(var.VlcInstallPrefix)VLC-AUTHORS.txt"/>
                            <File Id='COPYING.txt' Name='COPYING.txt' DiskId='1'  Source="$(var.VlcInstallPrefix)COPYING.txt"/>
                            <File Id='RELEASE_NOTES.txt' Name='RELEASE-NOTES.txt' DiskId='1'  Source="$(var.VlcInstallPrefix)RELEASE-NOTES.txt"/>
                            <File Id='README.txt' Name='README.txt' DiskId='1'  Source="$(var.VlcInstallPrefix)README.txt"/>
                            <File Id='VLC_THANKS.txt' Name='VLC-THANKS.txt' DiskId='1'  Source="$(var.VlcInstallPrefix)VLC-THANKS.txt"/>
                            <File Id='Inter_OFL.txt' Name='Inter-OFL.txt' DiskId='1'  Source="$(var.VlcInstallPrefix)Inter-OFL.txt"/>
                        </Component>

                        <Component Id='CompLibvlccore' Guid='a67b91b2-f31c-40b1-a424-807df44acf77' Win64="$(var.Win64)">
                            <File Id='libvlccore.dll' Name='libvlccore.dll' KeyPath='yes' Vital='yes' DiskId='1' Source="$(var.VlcInstallPrefix)libvlccore.dll"/>
                        </Component>

                        <Component Id='CompLibvlc' Guid='dd339494-6ae6-4369-a967-04c1f181f272' Win64="$(var.Win64)">
                            <File Id='libvlc.dll' Name='libvlc.dll' KeyPath='yes' Vital='yes' DiskId='1' Source="$(var.VlcInstallPrefix)libvlc.dll"/>
                        </Component>

                        <Component Id='CompCacheGen' Guid='3c2cafc0-ad9a-4303-80e0-53545b92734b' Win64="$(var.Win64)">
                            <File Id='vlc_cache_gen.exe' Name='vlc-cache-gen.exe' KeyPath='yes' DiskId='1' Source="$(var.VlcInstallPrefix)vlc-cache-gen.exe"/>
                        </Component>

                        <Component Id='CompPreparserExe' Guid='43bfaa03-e5ed-4216-8ca4-e47662f6b1da' Win64="$(var.Win64)">
                            <File Id='vlc_preparser.exe' Name='vlc-preparser.exe' KeyPath='yes' DiskId='1' Source="$(var.VlcInstallPrefix)vlc-preparser.exe"/>
                        </Component>

                        <Component Id='CompIcon' Guid='f847f4c2-e5bb-4465-84eb-88a6c3b32ed1' Win64="$(var.Win64)">
                            <File Id='vireo.ico' Name='vireo.ico' KeyPath='yes' DiskId='1'  Source="$(var.VlcInstallPrefix)vireo.ico"/>
                        </Component>

                        <Directory Id='PLUGINSDIR' Name='plugins'>
                            <Component Id='CompPluginsCache' Guid='8afeb464-abca-4817-9473-fe26b7fc4e50' Win64="$(var.Win64)">
                                <RemoveFile Id="RemovePluginsCache" Name="plugins.dat" On="uninstall" />
                            </Component>
                        </Directory>

                        <Component Id='CompPlayDiscs' Guid='4b4d6031-b2a0-492f-ab0e-2c76e5071461' Win64="$(var.Win64)">
                            <!-- Audio CD -->
                            <RegistryValue Root="HKCR" Key="AudioCD\shell\PlayWithVireo" Value="Play with $(var.ProductName)" Type="string" />
                            <RegistryValue Root="HKCR" Key="AudioCD\shell\PlayWithVireo\command" Value="&quot;[#vireo.exe]&quot; --started-from-file cdda:///%1" Type="string" />
                            <!-- DVD -->
                            <RegistryValue Root="HKCR" Key="DVD\shell\PlayWithVireo" Value="Play with $(var.ProductName)" Type="string" />
                            <RegistryValue Root="HKCR" Key="DVD\shell\PlayWithVireo\command" Value="&quot;[#vireo.exe]&quot; --started-from-file dvd:///%1" Type="string" />

                            <!-- DVD video Handler -->
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\EventHandlers\PlayDVDMovieOnArrival" Name="VireoPlayDVDMovieOnArrival" Value="" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayDVDMovieOnArrival" Name="Action" Value="Play DVD movie" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayDVDMovieOnArrival" Name="DefaultIcon" Value="[#vireo.exe],0" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayDVDMovieOnArrival" Name="InvokeProgID" Value="Vireo.DVDMovie" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayDVDMovieOnArrival" Name="InvokeVerb" Value="Open" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayDVDMovieOnArrival" Name="Provider" Value="$(var.ProductName)" Type="string" />

                            <!-- Audio CD Handler -->
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\EventHandlers\PlayCDAudioOnArrival" Name="VireoPlayCDAudioOnArrival" Value="" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayCDAudioOnArrival" Name="Action" Value="Play audio CD" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayCDAudioOnArrival" Name="DefaultIcon" Value="[#vireo.exe],0" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayCDAudioOnArrival" Name="InvokeProgID" Value="Vireo.CDAudio" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayCDAudioOnArrival" Name="InvokeVerb" Value="Open" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayCDAudioOnArrival" Name="Provider" Value="$(var.ProductName)" Type="string" />

                            <!-- VCD Handler -->
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\EventHandlers\PlayVideoCDMovieOnArrival" Name="VireoPlayVCDMovieOnArrival" Value="" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayVCDMovieOnArrival" Name="Action" Value="Play VCD movie" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayVCDMovieOnArrival" Name="DefaultIcon" Value="[#vireo.exe],0" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayVCDMovieOnArrival" Name="InvokeProgID" Value="Vireo.VCDMovie" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayVCDMovieOnArrival" Name="InvokeVerb" Value="Open" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayVCDMovieOnArrival" Name="Provider" Value="$(var.ProductName)" Type="string" />

                            <!-- SVCD Handler -->
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\EventHandlers\PlaySuperVideoCDMovieOnArrival" Name="VireoPlaySVCDMovieOnArrival" Value="" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlaySVCDMovieOnArrival" Name="Action" Value="Play SVCD movie" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlaySVCDMovieOnArrival" Name="DefaultIcon" Value="[#vireo.exe],0" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlaySVCDMovieOnArrival" Name="InvokeProgID" Value="Vireo.SVCDMovie" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlaySVCDMovieOnArrival" Name="InvokeVerb" Value="Open" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlaySVCDMovieOnArrival" Name="Provider" Value="$(var.ProductName)" Type="string" />

                            <!-- DVD Audio Handler -->
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\EventHandlers\PlayDVDAudioOnArrival" Name="VireoPlayDVDAudioOnArrival" Value="" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayDVDAudioOnArrival" Name="Action" Value="Play audio DVD" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayDVDAudioOnArrival" Name="DefaultIcon" Value="[#vireo.exe],0" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayDVDAudioOnArrival" Name="InvokeProgID" Value="Vireo.OPENFolder" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayDVDAudioOnArrival" Name="InvokeVerb" Value="Open" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayDVDAudioOnArrival" Name="Provider" Value="$(var.ProductName)" Type="string" />

                            <!-- Generic video files Handler -->
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\EventHandlers\PlayVideoFilesOnArrival" Name="VireoPlayVideoFilesOnArrival" Value="" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayVideoFilesOnArrival" Name="Action" Value="Play video files" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayVideoFilesOnArrival" Name="DefaultIcon" Value="[#vireo.exe],0" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayVideoFilesOnArrival" Name="InvokeProgID" Value="Vireo.OPENFolder" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayVideoFilesOnArrival" Name="InvokeVerb" Value="Open" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayVideoFilesOnArrival" Name="Provider" Value="$(var.ProductName)" Type="string" />

                            <!-- Generic audio files Handler -->
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\EventHandlers\PlayMusicFilesOnArrival" Name="VireoPlayMusicFilesOnArrival" Value="" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayMusicFilesOnArrival" Name="Action" Value="Play audio files" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayMusicFilesOnArrival" Name="DefaultIcon" Value="[#vireo.exe],0" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayMusicFilesOnArrival" Name="InvokeProgID" Value="Vireo.OPENFolder" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayMusicFilesOnArrival" Name="InvokeVerb" Value="Open" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayMusicFilesOnArrival" Name="Provider" Value="$(var.ProductName)" Type="string" />


                            <RegistryValue Root="HKCR" Key="Vireo.DVDMovie" Value="Vireo DVD Movie" Type="string" />
                            <RegistryValue Root="HKCR" Key="Vireo.DVDMovie\shell" Value="Open" Type="string" />
                            <RegistryValue Root="HKCR" Key="Vireo.DVDMovie\shell\open\command" Value="&quot;[#vireo.exe]&quot; --started-from-file dvd:///%1" Type="string" />
                            <RegistryValue Root="HKCR" Key="Vireo.DVDMovie\DefaultIcon" Value="[#vireo.exe],0" Type="string" />

                            <RegistryValue Root="HKCR" Key="Vireo.CDAudio" Value="Vireo CD Audio" Type="string" />
                            <RegistryValue Root="HKCR" Key="Vireo.CDAudio\shell" Value="Open" Type="string" />
                            <RegistryValue Root="HKCR" Key="Vireo.CDAudio\shell\open\command" Value="&quot;[#vireo.exe]&quot; --started-from-file cdda:///%1" Type="string" />
                            <RegistryValue Root="HKCR" Key="Vireo.CDAudio\DefaultIcon" Value="[#vireo.exe],0" Type="string" />

                            <RegistryValue Root="HKCR" Key="Vireo.VCDMovie" Value="Vireo VCD Movie" Type="string" />
                            <RegistryValue Root="HKCR" Key="Vireo.VCDMovie\shell" Value="Open" Type="string" />
                            <RegistryValue Root="HKCR" Key="Vireo.VCDMovie\shell\open\command" Value="&quot;[#vireo.exe]&quot; --started-from-file vcd:///%1" Type="string" />
                            <RegistryValue Root="HKCR" Key="Vireo.VCDMovie\DefaultIcon" Value="[#vireo.exe],0" Type="string" />

                            <RegistryValue Root="HKCR" Key="Vireo.SVCDMovie" Value="Vireo SVCD Movie" Type="string" />
                            <RegistryValue Root="HKCR" Key="Vireo.SVCDMovie\shell" Value="Open" Type="string" />
                            <RegistryValue Root="HKCR" Key="Vireo.SVCDMovie\shell\open\command" Value="&quot;[#vireo.exe]&quot; --started-from-file vcd:///%1" Type="string" />
                            <RegistryValue Root="HKCR" Key="Vireo.SVCDMovie\DefaultIcon" Value="[#vireo.exe],0" Type="string" />

                            <RegistryValue Root="HKCR" Key="Vireo.OPENFolder" Value="Vireo Play Content" Type="string" />
                            <RegistryValue Root="HKCR" Key="Vireo.OPENFolder\shell" Value="Open" Type="string" />
                            <RegistryValue Root="HKCR" Key="Vireo.OPENFolder\shell\open\command" Value="&quot;[#vireo.exe]&quot; %1" Type="string" />
                            <RegistryValue Root="HKCR" Key="Vireo.OPENFolder\DefaultIcon" Value="[#vireo.exe],0" Type="string" />
                        </Component>
                    </Directory>
            </Directory>

            <!-- shortcuts -->
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ProgramMenuProductFolder" Name="$(var.ShortProductName)" />
            </Directory>
            <Directory Id="DesktopFolder" Name="Desktop"/>
        </Directory>

        <DirectoryRef Id="ProgramMenuProductFolder">
            <Component Id="CompProgramMenuShortcuts" Guid="*" Win64="$(var.Win64)">
                <!-- create folders -->
                <CreateFolder Directory="ProgramMenuProductFolder" />
                <!-- remove folder -->
                <RemoveFolder Id="RemoveProgramMenuProductFolder"
                              Directory="ProgramMenuProductFolder"
                              On="uninstall" />
                <!-- Application shortcuts -->
                <Shortcut Id="VLCShortcut" Name="$(var.ProductName)" Target="[APPLICATIONFOLDER]vireo.exe" />
                <Shortcut Id="VLCCleanShortcut" Name="Reset $(var.ProductName) preferences and cache files" Target="[APPLICATIONFOLDER]vireo.exe" Arguments="--reset-config --reset-plugins-cache vlc://quit" />
                <Shortcut Id="ReleaseNotesShortcut" Name="Release Notes" Target="[APPLICATIONFOLDER]RELEASE-NOTES.txt" />
                <util:InternetShortcut Id="WebsiteShortcut" Name="$(var.ProductName) website" Target="$(var.AboutURL)"/>
                <!-- RegistryValue which serves as KeyPath -->
                <RegistryValue Root="HKCU"
                               Key="Software\Vireo"
                               Name="StartMenuShortcuts"
                               Type="integer"
                               Value="1"
                               KeyPath="yes" />
             </Component>
        </DirectoryRef>

        <Feature Id='VLC' Title='$(var.ProductName)' Level='1' Absent="disallow" AllowAdvertise="no" Display="expand" Description="The $(var.ProductName) application">
            <ComponentRef Id='InstallRegDir' />
            <ComponentRef Id='CompVLC' />
            <ComponentRef Id='CompLibvlccore' />
            <ComponentRef Id='CompLibvlc' />
            <ComponentRef Id='CompCacheGen' />
            <ComponentRef Id='CompPreparserExe' />
            <ComponentRef Id='CompIcon' />
            <ComponentRef Id='CompTXT' />
            <ComponentRef Id='CompPluginsCache' />
            <ComponentRef Id='CompProgramMenuShortcuts' />

            <ComponentGroupRef Id='CompPluginsGroup' />
            <?if "$(var.HaveLocale)" = "yes" ?>
                <ComponentGroupRef Id='CompLocaleGroup' />
            <?endif ?>
            <ComponentGroupRef Id='CompLuaGroup' />
            <?if "$(var.HaveSkins)" = "yes" ?>
                <ComponentGroupRef Id='CompSkinsGroup' />
            <?endif ?>

            <Feature Id='FILEASSOCIATION' Title='File associations' Level='1' AllowAdvertise="no">
                <Feature Id='VIDEOFILEASSOCIATION' Title='Video' Level='1' AllowAdvertise="no">
                    <ComponentRef Id='CompVideoFileAssociation' />
                </Feature>
                <Feature Id='AUDIOFILEASSOCIATION' Title='Audio' Level='1' AllowAdvertise="no">
                    <ComponentRef Id='CompAudioFileAssociation' />
                </Feature>
                <Feature Id='OTHERFILEASSOCIATION' Title='Others' Level='1' AllowAdvertise="no">
                    <ComponentRef Id='CompOtherFileAssociation' />
                </Feature>
            </Feature>
            <Feature Id='DISCSPLAYBACK' Title='Disc associations' Level='1' AllowAdvertise="no">
                <ComponentRef Id='CompPlayDiscs' />
            </Feature>
        </Feature>

        <UIRef Id="WixUI_Advanced" />
        <UIRef Id="WixUI_ErrorProgressText" />

        <InstallExecuteSequence>
            <!-- <RemoveExistingProducts After="InstallValidate" /> -->
            <Custom Action="ExecVLCNSISUninstall" Before="InstallValidate">NSISLOCATION AND NOT Installed</Custom>
            <Custom Action="ExecVLCCacheGen" Before="InstallFinalize">REINSTALL OR NOT Installed</Custom>
            <Custom Action="SetExecVLCCacheGen" Before="ExecVLCCacheGen">REINSTALL OR NOT Installed</Custom>
        </InstallExecuteSequence>

        <!-- Uninstall an older NSIS-installed $(var.ProductName) -->
        <CustomAction Id            = "ExecVLCNSISUninstall"
                      Directory     = "APPLICATIONFOLDER"
                      ExeCommand    = "[NSISLOCATION] /S"
                      Execute       = "immediate"
                      Impersonate   = "no"
                      Return        = "check" />
        <!-- Launch silently vlc-cache-gen.exe during install -->
        <CustomAction Id            = "SetExecVLCCacheGen"
                      Property      = "ExecVLCCacheGen"
                      Value         = "&quot;[#vlc_cache_gen.exe]&quot; &quot;[APPLICATIONFOLDER]plugins&quot;" />
        <CustomAction Id            = "ExecVLCCacheGen"
                      BinaryKey     = "WixCA"
                      DllEntry      = "CAQuietExec"
                      Execute       = "deferred"
                      Impersonate   = "no"
                      Return        = "ignore" />

        <!-- Launch $(var.ProductName) after setup exits -->
        <CustomAction Id            = "StartAppOnExit"
                      FileKey       = "vireo.exe"
                      ExeCommand    = ""
                      Execute       = "immediate"
                      Impersonate   = "yes"
                      Return        = "asyncNoWait" />
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
          Value="Launch $(var.ProductName) when setup exits." />
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

        <UI>
            <Publish Dialog  = "ExitDialog"
                     Control = "Finish"
                     Order   = "1"
                     Event   = "DoAction"
                     Value   = "StartAppOnExit">
                WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed
            </Publish>
            <ProgressText Action="ExecVLCCacheGen">Generating modules cache...</ProgressText>
       </UI>
   </Product>
</Wix>
