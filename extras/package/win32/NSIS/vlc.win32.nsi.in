    '"$INSTDIR\vireo.exe" --started-from-file cdda:///%1'
  WriteRegStr HKCR "Vireo.CDAudio\DefaultIcon" "" '"$INSTDIR\vireo.exe",0'

  WriteRegStr HKCR "Vireo.VCDMovie" "" "Vireo VCD Movie"
  WriteRegStr HKCR "Vireo.VCDMovie\shell" "" "Open"
  WriteRegStr HKCR "Vireo.VCDMovie\shell\Open\command" "" \
     '"$INSTDIR\vireo.exe" --started-from-file vcd:///%1'
  WriteRegStr HKCR "Vireo.VCDMovie\DefaultIcon" "" '"$INSTDIR\vireo.exe",0'

  WriteRegStr HKCR "Vireo.SVCDMovie" "" "Vireo SVCD Movie"
