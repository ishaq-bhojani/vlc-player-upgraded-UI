  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\VireoPlayVideoFilesOnArrival" "DefaultIcon" '"$INSTDIR\vireo.exe",0'
