;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; NSIS installer script for vlc ;
; (http://nsis.sourceforge.net) ;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Vireo: values from docs/redesign/branding.md
!define PRODUCT_NAME "Vireo"
!define VERSION @VERSION@
; Vireo's release version: Apps & Features, the installer file name and the upgrade check (VERSION above is VLC's engine version)
!define PRODUCT_VERSION "@REDESIGN_RELEASE_VERSION@"
; what the upgrade check stores and compares: release version.build number (the N of the updater's 4.0.0.N)
!define PRODUCT_VERSION_FULL "@REDESIGN_RELEASE_VERSION@.@REDESIGN_BUILD_NUMBER@"
!define PRODUCT_GROUP "Vireo"
!define PRODUCT_PUBLISHER "Vireo contributors"
!define PRODUCT_WEB_SITE "https://github.com/ishaq-bhojani/vlc-player-upgraded-UI"
; own key root: never read, write or delete Software\VideoLAN (stock VLC may be installed side by side)
!define PRODUCT_DIR_REGKEY "Software\Vireo"
!define PRODUCT_UNINST_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\${PRODUCT_NAME}"
!define PRODUCT_UNINST_ROOT_KEY "HKLM"
!define PRODUCT_ID "{ab4a9427-0088-405d-92d2-599cd3752765}"
; per-user folder under %APPDATA% (meson option redesign_user_dir): Vireo's own, never a stock VLC's "vlc"
!define USER_DIR_NAME @REDESIGN_USER_DIR_NAME@

!define MUI_LANGDLL_REGISTRY_ROOT "HKLM"
!define MUI_LANGDLL_REGISTRY_KEY "${PRODUCT_DIR_REGKEY}"
!define MUI_LANGDLL_REGISTRY_VALUENAME "Language"

!define MEMENTO_REGISTRY_ROOT ${PRODUCT_UNINST_ROOT_KEY}
!define MEMENTO_REGISTRY_KEY "${PRODUCT_UNINST_KEY}"

@HAVE_WIN64_TRUE@ !define VLC_64BIT_INSTALLER

ManifestDPIAware true
Unicode true

; !define INSTALL_ACTIVEX

Var ReinstallType
Var ReinstallUninstallBtn
Var PerformUpdate
Var PreviousVersion
Var PreviousVersionState
Var PreviousInstallDir
Var UninstallLog

Var 32bitUninstaller
Var 32bitPath

;;;;;;;;;;;;;;;;;;;;;;;;;
; General configuration ;
;;;;;;;;;;;;;;;;;;;;;;;;;

Name "${PRODUCT_NAME}"
@HAVE_WIN64_FALSE@                   OutFile ..\vireo-${PRODUCT_VERSION}-win32.exe
@HAVE_WIN64_TRUE@ @HAVE_ARM64_FALSE@ OutFile ..\vireo-${PRODUCT_VERSION}-win64.exe
@HAVE_WIN64_TRUE@ @HAVE_ARM64_TRUE@  OutFile ..\vireo-${PRODUCT_VERSION}-winarm64.exe
InstallDir "$@PROGRAMFILES@\${PRODUCT_NAME}"
!ifdef NSIS_LZMA_COMPRESS_WHOLE
SetCompressor lzma
!else
SetCompressor /SOLID lzma
!endif

SetOverwrite ifdiff
CRCCheck on
BrandingText "${PRODUCT_NAME}"

InstType "$(Name_InstTypeRecommended)"
InstType "$(Name_InstTypeMinimum)"
InstType "$(Name_InstTypeFull)"

RequestExecutionLevel admin
!addincludedir NSIS
!addplugindir NSIS
!include nsProcess.nsh
!include WinVer.nsh
!include FileFunc.nsh
!include MUI2.nsh
!include Memento.nsh

!insertmacro GetParameters
!insertmacro GetOptions

